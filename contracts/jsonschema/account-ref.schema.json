{
  "additionalProperties": false,
  "description": "A WeChat account and its authoritative filesystem boundary.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "examples": [
        "1.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "account_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9_@.-]+$",
      "title": "Account Id",
      "type": "string"
    },
    "account_root": {
      "maxLength": 1024,
      "minLength": 3,
      "title": "Account Root",
      "type": "string"
    },
    "display_name": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Display Name"
    },
    "source_version": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Version"
    }
  },
  "required": [
    "account_id",
    "account_root"
  ],
  "title": "AccountRef",
  "type": "object",
  "$id": "https://wechat-space-manager.local/schema/account-ref/1.0.json"
}

{
  "$defs": {
    "CleanupExecutionMode": {
      "enum": [
        "dry_run",
        "quarantine",
        "recycle_bin"
      ],
      "title": "CleanupExecutionMode",
      "type": "string"
    },
    "ReceiptStatus": {
      "enum": [
        "planned",
        "dry_run",
        "succeeded",
        "skipped",
        "failed"
      ],
      "title": "ReceiptStatus",
      "type": "string"
    },
    "RecoveryLocator": {
      "additionalProperties": false,
      "description": "Opaque, non-absolute locator for a recoverable operation result.",
      "properties": {
        "schema_version": {
          "default": "1.1",
          "examples": [
            "1.1"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "recovery_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,255}$",
          "title": "Recovery Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RecoveryLocatorKind"
        },
        "state": {
          "$ref": "#/$defs/RecoveryState"
        },
        "relative_path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Path"
        }
      },
      "required": [
        "recovery_id",
        "kind",
        "state"
      ],
      "title": "RecoveryLocator",
      "type": "object"
    },
    "RecoveryLocatorKind": {
      "enum": [
        "none",
        "quarantine",
        "recycle_bin"
      ],
      "title": "RecoveryLocatorKind",
      "type": "string"
    },
    "RecoveryState": {
      "enum": [
        "not_applicable",
        "available",
        "restored",
        "missing",
        "unknown"
      ],
      "title": "RecoveryState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Execution summary that separates processed bytes from reclaimed bytes.",
  "properties": {
    "schema_version": {
      "default": "1.1",
      "examples": [
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "execution_id": {
      "format": "uuid",
      "title": "Execution Id",
      "type": "string"
    },
    "plan_id": {
      "format": "uuid",
      "title": "Plan Id",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/CleanupExecutionMode"
    },
    "status": {
      "$ref": "#/$defs/ReceiptStatus"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "processed_bytes": {
      "default": 0,
      "minimum": 0,
      "title": "Processed Bytes",
      "type": "integer"
    },
    "reclaimed_bytes": {
      "default": 0,
      "minimum": 0,
      "title": "Reclaimed Bytes",
      "type": "integer"
    },
    "recovery": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RecoveryLocator"
      },
      "title": "Recovery",
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "mode",
    "status"
  ],
  "title": "CleanupExecution",
  "type": "object",
  "$id": "https://wechat-space-manager.local/schema/cleanup-execution/1.1.json"
}

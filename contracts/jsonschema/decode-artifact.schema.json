{
  "$defs": {
    "DecodeVariant": {
      "enum": [
        "thumbnail",
        "original"
      ],
      "title": "DecodeVariant",
      "type": "string"
    },
    "FileIdentity": {
      "additionalProperties": false,
      "description": "Stable facts rechecked before a cleanup executor touches a file.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "examples": [
            "1.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "modified_time_ns": {
          "minimum": 0,
          "title": "Modified Time Ns",
          "type": "integer"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "relative_path",
        "byte_size",
        "modified_time_ns"
      ],
      "title": "FileIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "examples": [
        "1.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "media_id": {
      "format": "uuid",
      "title": "Media Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "cache_session_id": {
      "format": "uuid",
      "title": "Cache Session Id",
      "type": "string"
    },
    "variant": {
      "$ref": "#/$defs/DecodeVariant"
    },
    "output_file": {
      "$ref": "#/$defs/FileIdentity"
    },
    "output_format": {
      "maxLength": 16,
      "minLength": 2,
      "pattern": "^[A-Za-z0-9]+$",
      "title": "Output Format",
      "type": "string"
    },
    "decoder_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Decoder Id",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    }
  },
  "required": [
    "request_id",
    "media_id",
    "cache_session_id",
    "variant",
    "output_file",
    "output_format",
    "decoder_id"
  ],
  "title": "DecodeArtifact",
  "type": "object",
  "$id": "https://wechat-space-manager.local/schema/decode-artifact/1.0.json"
}

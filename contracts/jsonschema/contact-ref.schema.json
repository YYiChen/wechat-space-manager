{
  "$defs": {
    "ContactKind": {
      "enum": [
        "direct",
        "group",
        "official",
        "unknown"
      ],
      "title": "ContactKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "examples": [
        "1.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "account_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9_@.-]+$",
      "title": "Account Id",
      "type": "string"
    },
    "contact_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Contact Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ContactKind"
    },
    "session_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Hash"
    },
    "display_name": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Display Name"
    },
    "remark": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Remark"
    }
  },
  "required": [
    "account_id",
    "contact_id",
    "kind"
  ],
  "title": "ContactRef",
  "type": "object",
  "$id": "https://wechat-space-manager.local/schema/contact-ref/1.0.json"
}

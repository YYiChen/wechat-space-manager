{
  "$defs": {
    "SelectionScope": {
      "enum": [
        "current_page",
        "current_result",
        "manual"
      ],
      "title": "SelectionScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable selection bound to a scan and filter digest.",
  "properties": {
    "schema_version": {
      "default": "1.1",
      "examples": [
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "selection_id": {
      "format": "uuid",
      "title": "Selection Id",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/SelectionScope"
    },
    "account_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Account Ids",
      "type": "array"
    },
    "scan_id": {
      "format": "uuid",
      "title": "Scan Id",
      "type": "string"
    },
    "scan_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scan Manifest Sha256",
      "type": "string"
    },
    "filter_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Filter Digest",
      "type": "string"
    },
    "selected_media_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Selected Media Ids",
      "type": "array"
    },
    "selected_record_keys": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Selected Record Keys",
      "type": "array"
    },
    "selected_count": {
      "minimum": 1,
      "title": "Selected Count",
      "type": "integer"
    },
    "selected_bytes": {
      "minimum": 0,
      "title": "Selected Bytes",
      "type": "integer"
    },
    "selection_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    }
  },
  "required": [
    "scope",
    "account_ids",
    "scan_id",
    "scan_manifest_sha256",
    "filter_digest",
    "selected_media_ids",
    "selected_record_keys",
    "selected_count",
    "selected_bytes",
    "selection_digest",
    "expires_at"
  ],
  "title": "SelectionSnapshot",
  "type": "object",
  "$id": "https://wechat-space-manager.local/schema/selection-snapshot/1.1.json"
}

        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Context",
      "type": "array"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "title": "ContractError",
  "type": "object",
  "$id": "https://wechat-space-manager.local/schema/contract-error/1.0.json"

{
  "$defs": {
    "ContractErrorCode": {
      "enum": [
        "SCHEMA_VERSION_UNSUPPORTED",
        "INVALID_PATH",
        "PATH_OUTSIDE_ACCOUNT_ROOT",
        "FILE_IDENTITY_MISMATCH",
        "ACCOUNT_MISMATCH",
        "MAPPING_UNAVAILABLE",
        "DECODER_UNAVAILABLE",
        "DECODE_FAILED",
        "CACHE_LIMIT_EXCEEDED",
        "WECHAT_RUNNING",
        "PLAN_INVALID",
        "PLAN_STALE",
        "EXECUTION_BLOCKED",
        "UNKNOWN"
      ],
      "title": "ContractErrorCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {

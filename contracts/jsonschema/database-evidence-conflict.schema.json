{
  "additionalProperties": false,
  "description": "Conflict metadata represented by digests rather than raw database values.",
  "properties": {
    "schema_version": {
      "default": "1.1",
      "examples": [
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "conflict_id": {
      "format": "uuid",
      "title": "Conflict Id",
      "type": "string"
    },
    "account_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9_@.-]+$",
      "title": "Account Id",
      "type": "string"
    },
    "media_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Media Id"
    },
    "field_name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "title": "Field Name",
      "type": "string"
    },
    "candidate_digests": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 2,
      "title": "Candidate Digests",
      "type": "array"
    },
    "reason": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "field_name",
    "candidate_digests",
    "reason"
  ],
  "title": "DatabaseEvidenceConflict",
  "type": "object",
  "$id": "https://wechat-space-manager.local/schema/database-evidence-conflict/1.1.json"
}

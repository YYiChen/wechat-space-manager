{
  "$defs": {
    "AccountRef": {
      "additionalProperties": false,
      "description": "A WeChat account and its authoritative filesystem boundary.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "examples": [
            "1.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "account_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9_@.-]+$",
          "title": "Account Id",
          "type": "string"
        },
        "account_root": {
          "maxLength": 1024,
          "minLength": 3,
          "title": "Account Root",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "source_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        }
      },
      "required": [
        "account_id",
        "account_root"
      ],
      "title": "AccountRef",
      "type": "object"
    },
    "CleanupExecutionMode": {
      "enum": [
        "dry_run",
        "quarantine",
        "recycle_bin"
      ],
      "title": "CleanupExecutionMode",
      "type": "string"
    },
    "CleanupReceiptItem": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0",
          "examples": [
            "1.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ReceiptStatus"
        },
        "actual_reclaim_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Actual Reclaim Bytes",
          "type": "integer"
        },
        "processed_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Processed Bytes",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContractError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "target_id",
        "status"
      ],
      "title": "CleanupReceiptItem",
      "type": "object"
    },
    "ContractError": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0",
          "examples": [
            "1.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "code": {
          "$ref": "#/$defs/ContractErrorCode"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "context": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Context",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ContractError",
      "type": "object"
    },
    "ContractErrorCode": {
      "enum": [
        "SCHEMA_VERSION_UNSUPPORTED",
        "INVALID_PATH",
        "PATH_OUTSIDE_ACCOUNT_ROOT",
        "FILE_IDENTITY_MISMATCH",
        "ACCOUNT_MISMATCH",
        "MAPPING_UNAVAILABLE",
        "DECODER_UNAVAILABLE",
        "DECODE_FAILED",
        "CACHE_LIMIT_EXCEEDED",
        "WECHAT_RUNNING",
        "PLAN_INVALID",
        "PLAN_STALE",
        "EXECUTION_BLOCKED",
        "UNKNOWN"
      ],
      "title": "ContractErrorCode",
      "type": "string"
    },
    "ReceiptStatus": {
      "enum": [
        "planned",
        "dry_run",
        "succeeded",
        "skipped",
        "failed"
      ],
      "title": "ReceiptStatus",
      "type": "string"
    },
    "RecoveryLocator": {
      "additionalProperties": false,
      "description": "Opaque, non-absolute locator for a recoverable operation result.",
      "properties": {
        "schema_version": {
          "default": "1.1",
          "examples": [
            "1.1"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "recovery_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,255}$",
          "title": "Recovery Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RecoveryLocatorKind"
        },
        "state": {
          "$ref": "#/$defs/RecoveryState"
        },
        "relative_path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Path"
        }
      },
      "required": [
        "recovery_id",
        "kind",
        "state"
      ],
      "title": "RecoveryLocator",
      "type": "object"
    },
    "RecoveryLocatorKind": {
      "enum": [
        "none",
        "quarantine",
        "recycle_bin"
      ],
      "title": "RecoveryLocatorKind",
      "type": "string"
    },
    "RecoveryState": {
      "enum": [
        "not_applicable",
        "available",
        "restored",
        "missing",
        "unknown"
      ],
      "title": "RecoveryState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Append-only execution evidence; executors may create it, planners may not.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "examples": [
        "1.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "receipt_id": {
      "format": "uuid",
      "title": "Receipt Id",
      "type": "string"
    },
    "plan_id": {
      "format": "uuid",
      "title": "Plan Id",
      "type": "string"
    },
    "account": {
      "$ref": "#/$defs/AccountRef"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReceiptStatus"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/CleanupReceiptItem"
      },
      "title": "Items",
      "type": "array"
    },
    "total_reclaimed_bytes": {
      "minimum": 0,
      "title": "Total Reclaimed Bytes",
      "type": "integer"
    },
    "executor_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Executor Id",
      "type": "string"
    },
    "execution_mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/CleanupExecutionMode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "processed_bytes": {
      "default": 0,
      "minimum": 0,
      "title": "Processed Bytes",
      "type": "integer"
    },
    "recovery": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RecoveryLocator"
      },
      "title": "Recovery",
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "account",
    "status",
    "items",
    "total_reclaimed_bytes",
    "executor_id"
  ],
  "title": "CleanupReceipt",
  "type": "object",
  "$id": "https://wechat-space-manager.local/schema/cleanup-receipt/1.0.json"
}
